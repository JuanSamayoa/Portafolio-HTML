---
import { Image } from "astro:assets";
import {
  additionalCertifications,
  featuredCertifications,
} from "../data/certifications";
import { optimizedCloudinary } from "../utils/cloudinary";
import CertModal from "./CertModal.astro";

const allCertificationsCount =
  featuredCertifications.length + additionalCertifications.length;
---

<section id="certificaciones">
  <div class="container">
    <div class="section-tag">certificaciones</div>
    <div class="certs-header">
      <h2 class="section-title">Formación continua</h2>
      <p>
        {allCertificationsCount} certificaciones en total, con las más
        relevantes visibles primero.
      </p>
    </div>
    <div class="certs-grid">
      {
        featuredCertifications.map((certification, index) => (
          <article class:list={["cert-card reveal", `reveal-delay-${(index % 4) + 1}`]}>
            <div class="cert-image">
              <Image
                src={optimizedCloudinary(
                  certification.image,
                  "f_auto,q_auto,c_limit,w_600",
                )}
                alt={`Certificación ${certification.title}`}
                width={400}
                height={250}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="cert-content">
              <div class="cert-issuer">{certification.issuer}</div>
              <h3 class="cert-name">{certification.title}</h3>
              <div class="cert-footer">
                <div class="cert-year">{certification.date}</div>
                {certification.link ? (
                  <a
                    href={certification.link}
                    class="cert-verify"
                    target="_blank"
                    rel="noreferrer"
                  >
                    verificar ->
                  </a>
                ) : (
                  <span class="cert-verify muted">sin link público</span>
                )}
              </div>
            </div>
            <button
              class="cert-card-trigger"
              type="button"
              aria-label={`Ver certificación: ${certification.title}`}
            ></button>
          </article>
        ))
      }
    </div>

    <details class="more-certs reveal">
      <summary>
        <span>ver más certificaciones</span>
        <strong>{additionalCertifications.length} adicionales</strong>
      </summary>
      <div class="more-certs-grid">
        {
          additionalCertifications.map((certification) => (
            <article class="mini-cert">
              <Image
                src={optimizedCloudinary(
                  certification.image,
                  "f_auto,q_auto,c_limit,w_400",
                )}
                alt={`Certificación ${certification.title}`}
                width={200}
                height={200}
                loading="lazy"
                decoding="async"
              />
              <div class="mini-cert-body">
                <div class="cert-issuer">{certification.issuer}</div>
                <h3 class="mini-cert-name">{certification.title}</h3>
                <div class="cert-footer">
                  <div class="cert-year">{certification.date}</div>
                  {certification.link ? (
                    <a
                      href={certification.link}
                      class="cert-verify"
                      target="_blank"
                      rel="noreferrer"
                    >
                      verificar ->
                    </a>
                  ) : (
                    <span class="cert-verify muted">sin link público</span>
                  )}
                </div>
              </div>
              <button
                class="mini-cert-trigger"
                type="button"
                aria-label={`Ver certificación: ${certification.title}`}
              ></button>
            </article>
          ))
        }
      </div>
    </details>
  </div>
</section>

<CertModal />

<script>
  function initCertCards() {
    const triggers = document.querySelectorAll<HTMLButtonElement>(
      ".cert-card-trigger, .mini-cert-trigger",
    );

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const card = trigger.closest<HTMLElement>("article");
        if (!card) return;

        const image = card.querySelector<HTMLImageElement>("img");
        const issuer = card.querySelector(".cert-issuer")?.textContent?.trim() || "";
        const title =
          card.querySelector(".cert-name, .mini-cert-name")?.textContent?.trim() || "";
        const date = card.querySelector(".cert-year")?.textContent?.trim() || "";
        const link = card.querySelector<HTMLAnchorElement>("a.cert-verify[href]")?.href;

        document.dispatchEvent(
          new CustomEvent("open-cert-modal", {
            detail: {
              image: image?.src || "",
              issuer,
              title,
              date,
              link,
              trigger,
            },
          }),
        );
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCertCards);
  } else {
    initCertCards();
  }
</script>
