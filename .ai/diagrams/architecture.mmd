flowchart TD
    subgraph BUILD["Build — pnpm build"]
        CFG["astro.config.mjs<br/>site · base · outDir · Vite"]
        PAGES["src/pages<br/>index · blog · [slug] · thanks · 404 · toolkit/sql · sitemap.xml · rss.xml"]
        LAYOUT["src/layouts/Layout.astro<br/>SEO · CSP · nav · footer · scripts"]
        COMP["src/components<br/>13 componentes de sección"]
        DATA["src/data<br/>personal · projects · certifications"]
        CONTENT["src/content/blog<br/>artículos Markdown"]
        CONFIG["src/content.config.ts<br/>esquema zod"]
        UTILS["src/utils/cloudinary.ts<br/>f_auto,q_auto"]
        TYPES["src/types/portfolio.ts<br/>contratos"]
        CSS["src/styles/global.css<br/>tokens y reglas"]
        DIST["dist/<br/>6 HTML · 2 endpoints · CSS y JS con hash"]
    end

    subgraph RUNTIME["Runtime — navegador"]
        NAV["Nav activa + reveal<br/>IntersectionObserver"]
        MODAL["Modal de certificaciones<br/>dialog + CustomEvent"]
        SQLUI["Copiar y descargar SQL<br/>clipboard + Blob"]
        FORM["Formulario de contacto"]
        BLOGFILTER["Filtro por tags<br/>aria-pressed + status"]
        COPYLINK["Copiar enlace del artículo"]
    end

    subgraph THIRD["Terceros"]
        CLD["Cloudinary<br/>imágenes de contenido"]
        GF["Google Fonts<br/>3 familias"]
        FS["FormSubmit.co<br/>entrega de email"]
        GHP["GitHub Pages<br/>hosting + CNAME"]
    end

    CFG --> PAGES
    PAGES --> LAYOUT
    PAGES --> COMP
    PAGES --> CONTENT
    CONTENT --> CONFIG
    COMP --> DATA
    DATA --> TYPES
    LAYOUT --> CSS
    LAYOUT --> DIST
    COMP --> DIST
    CSS --> DIST
    DIST --> GHP

    COMP -->|"img src remoto"| CLD
    LAYOUT -->|"link stylesheet"| GF
    FORM -->|"POST action"| FS
    FORM -.->|"redirect _next"| PAGES

    LAYOUT --> NAV
    COMP --> MODAL
    PAGES --> SQLUI
    PAGES --> BLOGFILTER
    PAGES --> COPYLINK
    COMP --> FORM
    COMP --> UTILS

    classDef build fill:#e1f5ee,stroke:#0f6e56,color:#04342c
    classDef runtime fill:#f0efe9,stroke:#5a5955,color:#1a1a18
    classDef third fill:#ffffff,stroke:#a3a199,color:#1a1a18
    class CFG,PAGES,LAYOUT,COMP,DATA,TYPES,CSS,DIST build
    class NAV,MODAL,SQLUI,FORM runtime
    class CLD,GF,FS,GHP third
