---
import { personalInfo } from "../data/personal";
import "../styles/global.css";
import Hero from "../components/Hero.astro";
import Impact from "../components/Impact.astro";
import Services from "../components/Services.astro";
import Cases from "../components/Cases.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Skills from "../components/Skills.astro";
import Toolkit from "../components/Toolkit.astro";
import Faq from "../components/Faq.astro";
import Certifications from "../components/Certifications.astro";
import Contact from "../components/Contact.astro";

const pageTitle = "Juan Samayoa | QA Automation Engineer";
const pageDescription =
  "Portafolio profesional de Juan Samayoa, QA Automation Engineer en Guatemala especializado en Playwright, Java, SQL y pruebas funcionales.";
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : "https://juan-samayoa.is-a.dev/";
const previewImage = Astro.site
  ? new URL(personalInfo.profileImage, Astro.site).toString()
  : "https://juan-samayoa.is-a.dev/assets/img/profile.jpg";

const schemaOrgPerson = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: personalInfo.name,
  jobTitle: personalInfo.title,
  email: personalInfo.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Guatemala City",
    addressCountry: "GT",
  },
  url: canonicalUrl,
  sameAs: [personalInfo.linkedin, personalInfo.github],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content="Juan Samayoa" />
    <meta
      name="keywords"
      content="QA Automation Engineer, Playwright, Java, Selenium, Postman, SQL, Guatemala, Testing"
    />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:alt" content="Foto de perfil de Juan Samayoa" />
    <meta property="og:site_name" content="Juan Samayoa Portfolio" />
    <meta property="og:locale" content="es_GT" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="theme-color" content="#0f6e56" />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
      crossorigin="anonymous"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(schemaOrgPerson)}
    />
  </head>
  <body>
    <nav>
      <a class="nav-logo" href="#hero" aria-label="Ir al inicio">
        <span class="nav-logo-dot"></span>
        Juan Samayoa
      </a>
      <ul class="nav-links">
        <li><a href="#impacto">impacto</a></li>
        <li><a href="#servicios">servicios</a></li>
        <li><a href="#casos">casos</a></li>
        <li><a href="#sobre">sobre</a></li>
        <li><a href="#experiencia">experiencia</a></li>
        <li><a href="#proyectos">proyectos</a></li>
        <li><a href="#habilidades">stack</a></li>
        <li><a href="#certificaciones">certs</a></li>
      </ul>
      <a href="#contacto" class="nav-cta">contacto -></a>
    </nav>

    <main>
      <Hero />
      <Impact />
      <Services />
      <Cases />
      <About />
      <Experience />
      <Projects />
      <Skills />
      <Toolkit />
      <Faq />
      <Certifications />
      <Contact />
    </main>

    <footer>
      <div class="container footer-inner">
        <div>© 2026 Juan Samayoa · Guatemala City</div>
        <div>
          built with <span>Astro</span> · deployed on <span>GitHub Pages</span>
        </div>
      </div>
    </footer>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add("visible");
          });
        },
        { threshold: 0.12 },
      );

      document
        .querySelectorAll(".reveal")
        .forEach((el) => observer.observe(el));

      const sections = document.querySelectorAll<HTMLElement>("section[id]");
      const navLinks = document.querySelectorAll(".nav-links a");

      window.addEventListener("scroll", () => {
        let current = "";
        sections.forEach((section) => {
          const top = section.offsetTop - 90;
          if (window.scrollY >= top) current = section.getAttribute("id") || "";
        });
        navLinks.forEach((link) => {
          link.classList.toggle(
            "active",
            link.getAttribute("href") === `#${current}`,
          );
        });
      });
    </script>
  </body>
</html>
