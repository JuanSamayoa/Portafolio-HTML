---
import Layout from "../layouts/Layout.astro";

const pageTitle = "¡Gracias por contactarme! — Juan Samayoa";
const pageDescription =
  "Mensaje enviado exitosamente. Confirmación de recepción con tiempo estimado de respuesta de 24 a 72 horas.";
const canonicalUrl = "https://juan-samayoa.is-a.dev/thanks";
const previewImage = "https://juan-samayoa.is-a.dev/favicon.svg";
const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  previewImage={previewImage}
  schemaOrg={schemaOrg}
  robots="noindex, follow"
>
  <div class="thanks-wrapper">
    <div class="thanks-card">
      <div class="thanks-icon" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="48"
          height="48"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
          <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
      </div>

      <h1 class="thanks-title">
        <span>¡Mensaje Recibido!</span>
        <span lang="en">Message Received!</span>
      </h1>

      <div class="thanks-body">
        <p lang="es">
          Gracias por ponerte en contacto. Tu mensaje ha sido enviado
          correctamente y responderé en un lapso estimado de
          <strong>24 a 72 horas</strong>.
        </p>
        <hr class="thanks-divider" aria-hidden="true" />
        <p lang="en">
          Thank you for reaching out. Your message has been successfully sent,
          and I will get back to you within an estimated timeframe of
          <strong>24 to 72 hours</strong>.
        </p>
      </div><a href="/" class="btn-primary">
            ← Volver al inicio / Back to Home
          </a>
    </div>
  </div>
</Layout>

<style>
  .thanks-wrapper {
    min-height: calc(100vh - 56px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
  }

  .thanks-card {
    max-width: 560px;
    width: 100%;
    background: #ffffff;
    border: 1px solid var(--gray-200);
    border-radius: 12px;
    padding: 2.5rem 2rem;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  .thanks-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    background: var(--teal-50);
    color: var(--teal-600);
    border-radius: 50%;
    margin-bottom: 1.5rem;
  }

  .thanks-title {
    font-family: var(--display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--gray-900);
    line-height: 1.25;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .thanks-title span[lang="en"] {
    font-size: 1.25rem;
    color: var(--gray-600);
    font-weight: 500;
  }

  .thanks-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
    text-align: left;
  }

  .thanks-body p {
    font-size: 0.95rem;
    color: var(--gray-600);
    line-height: 1.6;
  }

  .thanks-body strong {
    color: var(--teal-600);
    font-weight: 600;
  }

  .thanks-divider {
    border: 0;
    height: 1px;
    background: var(--gray-200);
    margin: 0;
  }
</style>
