---
import { Image } from "astro:assets";
import {
  additionalCertifications,
  featuredCertifications,
} from "../data/certifications";
import CertModal from "./CertModal.astro";

const allCertificationsCount =
  featuredCertifications.length + additionalCertifications.length;
---

<section id="certificaciones">
  <div class="container">
    <div class="section-tag">certificaciones</div>
    <div class="certs-header">
      <h2 class="section-title">Formación continua</h2>
      <p>
        {allCertificationsCount} certificaciones en total, con las más
        relevantes visibles primero.
      </p>
    </div>
    <div class="certs-grid">
      {
        featuredCertifications.map((certification, index) => (
          <article class:list={["cert-card reveal", `reveal-delay-${(index % 4) + 1}`]}>
            <div class="cert-image">
              <Image
                src={certification.image}
                alt={`Certificación ${certification.title}`}
                width={400}
                height={250}
                loading="lazy"
              />
            </div>
            <div class="cert-content">
              <div class="cert-issuer">{certification.issuer}</div>
              <h3 class="cert-name">{certification.title}</h3>
              <div class="cert-footer">
                <div class="cert-year">{certification.date}</div>
                {certification.link ? (
                  <a
                    href={certification.link}
                    class="cert-verify"
                    target="_blank"
                    rel="noreferrer"
                  >
                    verificar ->
                  </a>
                ) : (
                  <span class="cert-verify muted">sin link público</span>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <details class="more-certs reveal">
      <summary>
        <span>ver más certificaciones</span>
        <strong>{additionalCertifications.length} adicionales</strong>
      </summary>
      <div class="more-certs-grid">
        {
          additionalCertifications.map((certification) => (
            <article class="mini-cert">
              <Image
                src={certification.image}
                alt={`Certificación ${certification.title}`}
                width={200}
                height={200}
                loading="lazy"
              />
              <div class="mini-cert-body">
                <div class="cert-issuer">{certification.issuer}</div>
                <h3 class="mini-cert-name">{certification.title}</h3>
                <div class="cert-footer">
                  <div class="cert-year">{certification.date}</div>
                  {certification.link ? (
                    <a
                      href={certification.link}
                      class="cert-verify"
                      target="_blank"
                      rel="noreferrer"
                    >
                      verificar ->
                    </a>
                  ) : (
                    <span class="cert-verify muted">sin link público</span>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </details>
  </div>
</section>

<CertModal />

<script>
  // Attach click handlers to certification cards
  function initCertCards() {
    const certCards = document.querySelectorAll('.cert-card, .mini-cert');
    
    certCards.forEach((card) => {
      // Add interactive attributes
      card.setAttribute('role', 'button');
      card.setAttribute('tabindex', '0');
      card.setAttribute('aria-label', 'Ver certificación en detalle');

      const imageData = card.querySelector('img');
      const issuer = card.querySelector('.cert-issuer')?.textContent || '';
      const title = card.querySelector('.cert-name, .mini-cert-name')?.textContent || '';
      const date = card.querySelector('.cert-year')?.textContent || '';
      const linkEl = card.querySelector('a.cert-verify[href]') as HTMLAnchorElement;
      const link = linkEl?.href;

      const openHandler = () => {
        // Dispatch custom event to open modal
        document.dispatchEvent(new CustomEvent('open-cert-modal', {
          detail: {
            image: imageData?.src || '',
            issuer,
            title,
            date,
            link,
          }
        }));
      };

      card.addEventListener('click', openHandler);
      card.addEventListener('keydown', (e: Event) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
          e.preventDefault();
          openHandler();
        }
      });
    });
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCertCards);
  } else {
    initCertCards();
  }
</script>
