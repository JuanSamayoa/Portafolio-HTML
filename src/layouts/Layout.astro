---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  previewImage: string;
  ogImage?: string;
  ogImageType?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  schemaOrg: Record<string, unknown>;
  robots?: string;
}

const {
  title,
  description,
  canonicalUrl,
  previewImage,
  ogImage = previewImage,
  ogImageType = "image/png",
  ogImageWidth = 1200,
  ogImageHeight = 630,
  schemaOrg,
  robots = "index, follow, max-image-preview:large",
} = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const isHome = Astro.url.pathname === base;
const sectionHref = (id: string) => (isHome ? `#${id}` : `${base}#${id}`);
const navLinks = [
  { id: "impacto", text: "impacto" },
  { id: "servicios", text: "servicios" },
  { id: "casos", text: "casos" },
  { id: "sobre", text: "sobre" },
  { id: "experiencia", text: "experiencia" },
  { id: "proyectos", text: "proyectos" },
  { id: "habilidades", text: "stack" },
  { id: "certificaciones", text: "certs" },
].map(({ id, text }) => ({ href: sectionHref(id), text }));
---

<!doctype html>
<html
  lang="es"
  class="no-js"
  data-home={isHome ? "true" : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      document.documentElement.classList.replace("no-js", "js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content="Juan Samayoa" />
    <meta
      name="keywords"
      content="QA Automation Engineer, Playwright, Java, Selenium, Postman, SQL, Guatemala, Testing"
    />
    <meta name="robots" content={robots} />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://formsubmit.co; base-uri 'self'; form-action 'self' https://formsubmit.co"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta
      property="og:image:alt"
      content="Vista previa del portafolio de Juan Samayoa"
    />
    <meta property="og:site_name" content="Juan Samayoa Portfolio" />
    <meta property="og:locale" content="es_GT" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@JSamayoa_" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <meta
      name="twitter:image:alt"
      content="Vista previa del portafolio de Juan Samayoa"
    />
    <meta name="theme-color" content="#0f6e56" />
    <meta name="application-name" content="Juan Samayoa" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="format-detection" content="telephone=no" />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
      crossorigin="anonymous"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(schemaOrg)}
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      Saltar al contenido principal / Skip to main content
    </a>
    <nav class="site-nav" aria-label="Navegación principal">
      <a
        class="nav-logo"
        href={isHome ? "#hero" : base}
        aria-label="Ir al inicio"
      >
        <span class="nav-logo-dot"></span>
        Juan Samayoa
      </a>
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-navigation"
        aria-label="Abrir menú de navegación"
      >
        <span class="nav-toggle-icon" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
      <ul class="nav-links" id="primary-navigation">
        {
          navLinks.map(({ href, text }) => (
            <li>
              <a href={href}>{text}</a>
            </li>
          ))
        }
      </ul>
      <a href={sectionHref("contacto")} class="nav-cta">contacto -></a>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <footer aria-label="Pie de página">
      <div class="container footer-inner">
        <div>© 2026 Juan Samayoa · Guatemala City</div>
        <div>
          built with <span>Astro</span> · deployed on <span>GitHub Pages</span>
        </div>
      </div>
    </footer>

    <script>
      // Reveal on scroll — anima cuando el elemento está ~35% arriba del viewport
      const io = new IntersectionObserver(
        (es) =>
          es.forEach(
            (e) => e.isIntersecting && e.target.classList.add("visible"),
          ),
        { rootMargin: "0px 0px -35% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // Active nav link on scroll
      const sections = document.querySelectorAll<HTMLElement>("section[id]");
      const links = document.querySelectorAll(".nav-links a");
      let ticking = false;

      window.addEventListener("scroll", () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          let current = "";
          sections.forEach((s) => {
            if (window.scrollY >= s.offsetTop - 90) current = s.id;
          });
          links.forEach((l) => {
            const href = l.getAttribute("href") ?? "";
            l.classList.toggle(
              "active",
              href.startsWith("#") && href === `#${current}`,
            );
          });
          ticking = false;
        });
      });

      // Menú de navegación móvil
      const nav = document.querySelector<HTMLElement>(".site-nav");
      const toggle = nav?.querySelector<HTMLButtonElement>(".nav-toggle");
      const menu = nav?.querySelector<HTMLElement>("#primary-navigation");
      const desktop = window.matchMedia("(min-width: 941px)");
      let menuOpen = false;

      function setMenu(open: boolean, returnFocus = false) {
        if (!nav || !toggle || !menu) return;
        menuOpen = open;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute(
          "aria-label",
          open ? "Cerrar menú de navegación" : "Abrir menú de navegación",
        );
        menu.classList.toggle("is-open", open);
        document.body.style.overflow = open ? "hidden" : "";
        if (open) {
          menu.querySelector<HTMLAnchorElement>("a")?.focus();
        } else if (returnFocus) {
          toggle.focus();
        }
      }

      toggle?.addEventListener("click", () => setMenu(!menuOpen, menuOpen));

      menu?.addEventListener("click", (event) => {
        if ((event.target as Element).closest("a")) setMenu(false);
      });

      nav
        ?.querySelectorAll<HTMLAnchorElement>(".nav-logo, .nav-cta")
        .forEach((link) => {
          link.addEventListener("click", () => {
            if (menuOpen) setMenu(false);
          });
        });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menuOpen) {
          event.preventDefault();
          setMenu(false, true);
        }
      });

      desktop.addEventListener("change", (event) => {
        if (event.matches && menuOpen) setMenu(false);
      });
    </script>
  </body>
</html>
