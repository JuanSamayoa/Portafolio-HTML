---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { optimizedCloudinary } from "../../utils/cloudinary";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.draft !== true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection("blog", ({ data }) => data.draft !== true);
const otherPosts = allPosts.filter((p) => p.id !== post.id);

const relatedPosts = (() => {
  const shared = otherPosts.filter((p) =>
    p.data.tags.some((tag) => post.data.tags.includes(tag)),
  );
  return shared
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, 2)
    .map((p) => {
      const words = (p.body ?? "").trim().split(/\s+/).filter(Boolean).length;
      const minutes = Math.max(1, Math.round(words / 200));
      return {
        ...p,
        dateFormatter: new Intl.DateTimeFormat("es-GT", {
          day: "numeric",
          month: "long",
          year: "numeric",
        }),
        minutes,
      };
    });
})();

const { title, description, pubDate, updatedDate, cover, coverAlt, tags } =
  post.data;

const site = Astro.site ?? new URL("https://juan-samayoa.is-a.dev");
const lang = Astro.locale ?? "es";
const langPrefix = lang === "en" ? "/en" : "";
const canonicalUrl = new URL(`${langPrefix}/blog/${post.id}/`, site).toString();

const absoluteCover = cover
  ? optimizedCloudinary(
      new URL(cover, site).toString(),
      "f_auto,q_auto,c_limit,w_1200",
    )
  : undefined;

const ogFromCover = absoluteCover ?? undefined;
const ogFallback = "https://res.cloudinary.com/df3b2ec0h/image/upload/v1785553053/og-image_vonu7x.png";
const previewImage = absoluteCover ?? ogFallback;
const isPostCoverDefined = Boolean(cover);

const ogImage = isPostCoverDefined ? ogFromCover : undefined;
const ogImageType = "image/png";
const ogImageWidth = 1200;
const ogImageHeight = 630;

const pageTitle = `${title} | Blog — Juan Samayoa`;

const dateFormatter = new Intl.DateTimeFormat("es-GT", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const words = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  url: canonicalUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: lang === "en" ? "en" : "es-419",
  image: previewImage,
  keywords: tags.join(", "),
  author: {
    "@type": "Person",
    name: "Juan Samayoa",
    url: new URL(langPrefix, site).toString(),
  },
  publisher: { "@type": "Person", name: "Juan Samayoa" },
};
---

<Layout
  title={pageTitle}
  {description}
  {canonicalUrl}
  {previewImage}
  {ogImage}
  {ogImageType}
  {ogImageWidth}
  {ogImageHeight}
  {schemaOrg}
>
  <article class="post">
    <header class="post-header">
      <div class="container post-header-inner">
        <a
          class="back-link"
          href={lang === "en" ? "/en/blog/" : "/blog/"}
        >
          {lang === "en" ? "← back to blog" : "← volver al blog"}
        </a>

        <div class="post-header-meta">
          <time datetime={pubDate.toISOString()}>
            {dateFormatter.format(pubDate)}
          </time>
          <span aria-hidden="true">·</span>
          <span>{minutes} min de lectura</span>
          {
            updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  {lang === "en" ? "updated on" : "actualizado el"}
                  {" "}
                  {dateFormatter.format(updatedDate)}
                </span>
              </>
            )
          }
        </div>

        <h1 class="post-title" data-title={title}>{title}</h1>
        <p class="post-lead">{description}</p>

        {
          tags.length > 0 && (
            <ul class="post-tags">
              {tags.map((tag) => (
                <li class="tag tag-primary">{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    {
      cover && (
        <figure class="post-cover">
          <div class="container">
            <img
              src={absoluteCover}
              alt={coverAlt ?? title}
              width="1200"
              height="675"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </figure>
      )
    }

    <div class="container post-layout">
      <div class="prose">
        <Content />
      </div>

      <div class="reader-progress" data-reader-progress aria-hidden="true">
        <div class="reader-progress__bar" data-reader-progress-bar></div>
      </div>

      <footer class="post-footer">
        <button class="copy-link" type="button" data-copy-link>
          {lang === "en" ? "copy article link" : "copiar enlace del artículo"}
        </button>
        <a
          class="post-footer-back"
          href={lang === "en" ? "/en/blog/" : "/blog/"}
        >
          {lang === "en" ? "← all articles" : "← todos los artículos"}
        </a>
      </footer>

      {
        relatedPosts.length > 0 && (
          <section class="related-posts" aria-labelledby="related-title">
            <h2 class="related-title" id="related-title">
              {lang === "en" ? "Related articles" : "Artículos relacionados"}
            </h2>
            <div class="related-grid">
              {relatedPosts.map((related) => (
                <article class="related-card">
                  <a
                    href={`${lang === "en" ? "/en/blog/" : "/blog/"}${related.id}/`}
                  >
                    <div class="related-body">
                      <div class="related-meta">
                        <time
                          datetime={related.data.pubDate.toISOString()}
                        >
                          {related.dateFormatter.format(
                            related.data.pubDate,
                          )}
                        </time>
                        <span aria-hidden="true">·</span>
                        <span>{related.minutes} min de lectura</span>
                      </div>
                      <h3 class="related-title">
                        <a
                          href={`${lang === "en" ? "/en/blog/" : "/blog/"}${related.id}/`}
                        >
                          {related.data.title}
                        </a>
                      </h3>
                      <p class="related-desc">{related.data.description}</p>
                      {
                        related.data.tags.length > 0 && (
                          <ul class="related-tags">
                            {related.data.tags.map((tag) => (
                              <li class="tag">{tag}</li>
                            ))}
                          </ul>
                        )
                      }
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>
</Layout>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy-link]");

  if (button) {
    const label = button.textContent ?? "";
    let resetTimer = 0;

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        button.textContent =
          lang === "en" ? "✓ article link copied" : "✓ enlace copiado";
        button.classList.add("is-copied");
      } catch {
        button.textContent =
          lang === "en" ? "could not copy" : "no se pudo copiar";
      }
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        button.textContent = label;
        button.classList.remove("is-copied");
      }, 2000);
    });
  }

  // Barra de progreso de lectura — fina, fija y ligera; construida en build
  // pero activada en cliente con requestAnimationFrame y
  // `prefers-reduced-motion: reduce`.
  const readerProgress =
    document.querySelector<HTMLElement>("[data-reader-progress]");
  const readerProgressBar =
    document.querySelector<HTMLElement>("[data-reader-progress-bar]");

  if (
    readerProgress &&
    readerProgressBar &&
    typeof window !== "undefined" &&
    "requestAnimationFrame" in window
  ) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    let ticking = false;

    const update = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      const progress =
        max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;

      if (reduceMotion.matches) {
        readerProgressBar.style.transform = `scaleX(${progress / 100})`;
      } else {
        readerProgressBar.style.transform = `scaleX(${progress / 100})`;
      }

      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(update);
      },
      { passive: true },
    );
  }

  // Botones de copiar código en bloques pre del artículo — inyectados una sola
  // vez, en el servidor, con su texto inicial en el atributo data-copy-original,
  // para respetar la CSP y el patrón existente de copiar enlaces.
  const allPre = document.querySelectorAll<HTMLPreElement>(
    ".prose :global(pre[data-copy-code])",
  );
  allPre.forEach((pre) => {
    const code = pre.querySelector<HTMLElement>("code");
    const source = code?.textContent ?? pre.textContent ?? "";
    if (source.trim().length === 0) return;

    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "copy-code";
    btn.setAttribute("aria-label", lang === "en" ? "Copy code" : "Copiar código");
    btn.textContent = lang === "en" ? "Copy code" : "Copiar código";
    btn.dataset.copyOriginal = lang === "en" ? "Copy code" : "Copiar código";
    pre.appendChild(btn);
  });

  const copyButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".copy-code"),
  );

  copyButtons.forEach((button) => {
    const pre = button.previousElementSibling as HTMLElement | null;
    const label =
      button.dataset.copyOriginal ??
      (lang === "en" ? "Copy code" : "Copiar código");
    let resetTimer: ReturnType<typeof setTimeout> = 0;

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(
          pre?.querySelector<HTMLPreElement>("code")?.textContent ?? "",
        );
        button.textContent = lang === "en" ? "✓ Copied" : "✓ Copiado";
        button.classList.add("is-copied");
      } catch {
        button.textContent = lang === "en" ? "Copy failed" : "No se pudo copiar";
        button.classList.remove("is-copied");
      }

      window.clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        button.textContent = label;
        button.classList.remove("is-copied");
      }, 2000);
    });
  });
</script>

<style>
  .post-header {
    padding: 132px 0 40px;
    background: var(--gray-50);
  }

  .post-header-inner {
    max-width: 1080px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 26px;
    color: var(--teal-600);
    font-family: var(--mono);
    font-size: 12px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--teal-400);
  }

  .post-header-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--gray-600);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .post-title {
    max-width: 22ch;
    margin: 16px 0 18px;
    font-family: var(--display);
    font-size: clamp(34px, 5vw, 60px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--gray-900);
    text-wrap: balance;
  }

  .post-lead {
    max-width: 64ch;
    color: var(--gray-600);
    font-size: 18px;
    line-height: 1.65;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
    list-style: none;
  }

  .post-cover {
    margin: 0;
    padding: 40px 0 0;
    background: var(--gray-50);
  }

  .post-cover img {
    width: 100%;
    height: auto;
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .post-layout {
    padding-top: 44px;
    padding-bottom: var(--section-space);
  }

  .prose {
    max-width: 72ch;
    font-size: 17px;
    line-height: 1.78;
    color: var(--gray-900);
  }

  .prose > * + * {
    margin-top: 1.15em;
  }

  .prose h2 {
    margin-top: 2.2em;
    padding-top: 0.2em;
    font-family: var(--display);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--gray-900);
    text-wrap: balance;
  }

  .prose h3 {
    margin-top: 1.9em;
    font-family: var(--display);
    font-size: 23px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--gray-900);
  }

  .prose p,
  .prose li {
    color: var(--gray-600);
    text-wrap: pretty;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.3em;
  }

  .prose li + li {
    margin-top: 0.45em;
  }

  .prose a {
    color: var(--teal-600);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .prose a:hover {
    color: var(--teal-400);
  }

  .prose strong {
    color: var(--gray-900);
    font-weight: 600;
  }

  .prose blockquote {
    margin-top: 1.6em;
    padding: 4px 0 4px 20px;
    border-left: 2px solid var(--teal-400);
    color: var(--gray-600);
    font-style: italic;
  }

  .prose hr {
    margin: 2.4em 0;
    border: 0;
    height: 1px;
    background: var(--gray-200);
  }

  .prose code {
    padding: 2px 6px;
    border: 1px solid var(--gray-200);
    border-radius: 4px;
    background: var(--gray-100);
    color: var(--teal-800);
    font-family: var(--mono);
    font-size: 0.86em;
  }

  .prose pre {
    overflow-x: auto;
    margin-top: 1.6em;
    padding: 20px;
    border-radius: var(--radius-md);
    background: var(--gray-900);
    border: 1px solid rgba(13, 148, 136, 0.08);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    line-height: 1.7;
    -webkit-overflow-scrolling: touch;
    position: relative;
  }

  .prose pre[data-copy-code] {
    /* Estilo inicial idéntico; el botón se posiciona desde la esquina superior
       derecha sin empujar el código. */
  }

  .prose .copy-code {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    min-width: 92px;
    padding: 5px 9px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 6px;
    background: rgba(15, 23, 42, 0.78);
    backdrop-filter: blur(6px);
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease-out),
      background 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }

  .prose .copy-code:hover {
    border-color: rgba(13, 148, 136, 0.7);
    background: rgba(15, 23, 42, 0.92);
    color: #e6fffa;
  }

  .prose .copy-code:focus-visible {
    outline: 2px solid var(--teal-400);
    outline-offset: 2px;
  }

  .prose .copy-code.is-copied {
    background: var(--teal-600);
    border-color: var(--teal-600);
    color: #ffffff;
  }

  .post-cover {
    aspect-ratio: 16 / 9;
    width: 100%;
    border-radius: var(--radius-lg);
    background: var(--gray-200);
    overflow: hidden;
    position: relative;

    img {
      height: 100%;
      object-fit: cover;
    }

    figcaption {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 12px 16px;
      background: linear-gradient(to top, var(--gray-900) 0%, transparent 100%);
      color: var(--gray-100);
      font-size: 0.875rem;

      a {
        color: var(--gray-100);
        text-decoration: underline;
        text-underline-offset: 3px;

        &:hover {
          text-decoration-thickness: 2px;
        }
      }
    }
  }

  #primary-navigation {
    border-radius: var(--radius-md);
    border: 1px solid var(--divider);
    box-shadow: 0 1px 0 var(--divider);
  }

  .post-title {
    font-size: clamp(2rem, 5vw, 3rem);
    &:hover {
      text-decoration: underline;
      text-decoration-thickness: 2px;
    }
  }

  .post-tag {
    color: var(--gray-500);
    font-weight: 500;
    font-size: 0.875rem;

    a {
      color: var(--gray-500);
      background: var(--gray-100);
      border-radius: var(--radius-md);
      padding: 4px 12px;
      font-size: 0.875rem;
      font-weight: 500;
      line-height: 1.25;
      text-decoration: none;
      transition: background-color 200ms ease, color 200ms ease;

      &:hover {
        background: var(--teal-50);
        color: var(--teal-700);
      }
    }
  }

  .post-footer {
    border-top: 1px solid var(--gray-200);
    margin-top: 80px;
    padding-top: 20px;
    justify-content: space-between;
    font-size: 0.875rem;

    a {
      color: var(--gray-600);
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: text-decoration-color 200ms ease;

      &:hover {
        text-decoration-color: var(--teal-600);
      }
    }
  }

  .post-content {
    max-width: 720px;
    margin: 0 auto;
  }

  ::marker {
    color: var(--teal-600);
  }

  code:not(.astro-code):not(code[class]) {
    font-family: ui-monospace, "SF Mono", "Fira Code", Menlo, Consolas,
      monospace;
    font-size: 0.875em;
    background: var(--gray-100);
    border-radius: 4px;
    padding: 0.2em 0.4em;
  }

  a code {
    color: var(--teal-700);
    background: transparent;
    border-radius: 0;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  pre {
    padding: 0;
    margin: 32px 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--divider);
    background: var(--gray-900);
  }

  pre > code {
    font-size: 0.875rem;
    line-height: 1.6;
    background: transparent;
    padding: 16px;
    overflow-x: auto;
    white-space: pre;
  }

  pre[data-copy-code] {
    position: relative;

    code[class] {
      border-radius: 0;
      border-right: 0;
      border-left: 0;
    }
  }

  .copy-code {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-md);
    background: var(--gray-700);
    color: var(--gray-100);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    border: 1px solid var(--divider);
    transition: background-color 200ms ease, color 200ms ease;
  }

  .copy-code:hover {
    background: var(--teal-600);
    color: var(--gray-100);
  }

  .copy-code:focus-visible {
    outline: 2px solid var(--teal-600);
    outline-offset: 2px;
  }

  .copy-code.is-copied {
    background: var(--teal-600);
    color: var(--gray-100);
    border-color: var(--teal-600);
  }

  .reader-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gray-200);
    z-index: 100;
  }

  .reader-progress__bar {
    height: 100%;
    background: var(--teal-600);
    width: 0%;
    transform-origin: left center;
    transition: transform 100ms linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .reader-progress__bar {
      transition: none;
    }
  }

  .post-cta {
    border: 1px solid var(--divider);
    border-radius: var(--radius-lg);
    padding: 16px 20px;
    background: var(--gray-50);
    flex: 1;
    font-size: 0.95rem;
  }

  .post-cta {
    border: 1px solid var(--divider);
    border-radius: var(--radius-lg);
    padding: 16px 20px;
    background: var(--gray-50);
    flex: 1;
    font-size: 0.95rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--gray-700);
    text-decoration: none;
    transition: background-color 200ms ease, border-color 200ms ease;

    svg {
      flex-shrink: 0;
    }

    &:hover {
      background: var(--teal-50);
      border-color: var(--teal-500);
    }
  }

  .related-posts {
    margin-top: 80px;
    padding-top: 24px;
    border-top: 1px solid var(--gray-200);
  }

  .related-title {
    margin: 0 0 18px;
    font-family: var(--display);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--gray-900);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 18px;
  }

  .related-card {
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-lg);
    background: var(--gray-50);
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .related-card:hover {
    border-color: var(--teal-300);
    box-shadow: var(--shadow-card-hover);
  }

  .related-card a {
    display: block;
    padding: 16px;
    text-decoration: none;
    color: inherit;
  }

  .related-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    color: var(--gray-600);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .related-meta > span {
    color: var(--gray-500);
