---
import About from "../components/About.astro";
import Cases from "../components/Cases.astro";
import Certifications from "../components/Certifications.astro";
import Contact from "../components/Contact.astro";
import Experience from "../components/Experience.astro";
import Faq from "../components/Faq.astro";
import Hero from "../components/Hero.astro";
import Impact from "../components/Impact.astro";
import Projects from "../components/Projects.astro";
import Services from "../components/Services.astro";
import Skills from "../components/Skills.astro";
import Toolkit from "../components/Toolkit.astro";
import { personalInfo } from "../data/personal";
import Layout from "../layouts/Layout.astro";

const title = "Juan Samayoa | QA Automation Engineer";
const description =
  "Portafolio profesional de Juan Samayoa, QA Automation Engineer en Guatemala especializado en Playwright, Java, SQL y pruebas funcionales.";
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : "https://juan-samayoa.is-a.dev/";
const previewImage = Astro.site
  ? new URL("/og-image.png", Astro.site).toString()
  : "https://juan-samayoa.is-a.dev/og-image.png";

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: personalInfo.name,
  jobTitle: personalInfo.title,
  email: personalInfo.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Guatemala City",
    addressCountry: "GT",
  },
  url: canonicalUrl,
  sameAs: [personalInfo.linkedin, personalInfo.github],
};
---

<Layout {title} {description} {canonicalUrl} {previewImage} {schemaOrg}>
  <Hero />
  <Impact />
  <Services />
  <Cases />
  <About />
  <Experience />
  <Projects />
  <Skills />
  <Toolkit />
  <Faq />
  <Certifications />
  <Contact />
</Layout>
