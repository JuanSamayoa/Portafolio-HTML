---
import About from "../components/About.astro";
import Cases from "../components/Cases.astro";
import Certifications from "../components/Certifications.astro";
import Contact from "../components/Contact.astro";
import Experience from "../components/Experience.astro";
import Faq from "../components/Faq.astro";
import Hero from "../components/Hero.astro";
import Impact from "../components/Impact.astro";
import Projects from "../components/Projects.astro";
import Services from "../components/Services.astro";
import Skills from "../components/Skills.astro";
import Toolkit from "../components/Toolkit.astro";
import { personalInfo } from "../data/personal";
import Layout from "../layouts/Layout.astro";

const title = "Juan Samayoa | QA Automation Engineer";
const description =
  "Portafolio profesional de Juan Samayoa, QA Automation Engineer en Guatemala especializado en Playwright, Java, SQL y pruebas funcionales.";
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : "https://juan-samayoa.is-a.dev/";
const previewImage =
  "https://res.cloudinary.com/df3b2ec0h/image/upload/v1785438411/IMG_8748_baq06u.jpg";
const ogImage =
  "https://res.cloudinary.com/df3b2ec0h/image/upload/v1785553053/og-image_vonu7x.png";
const ogImageType = "image/png";
const ogImageWidth = 1200;
const ogImageHeight = 630;

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: personalInfo.name,
  jobTitle: personalInfo.title,
  email: personalInfo.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Guatemala City",
    addressCountry: "GT",
  },
  url: canonicalUrl,
  sameAs: [personalInfo.linkedin, personalInfo.github],
};
---

<Layout
  {title}
  {description}
  {canonicalUrl}
  {previewImage}
  {ogImage}
  {ogImageType}
  {ogImageWidth}
  {ogImageHeight}
  {schemaOrg}
>
  <Hero />
  <Impact />
  <Services />
  <Cases />
  <About />
  <Experience />
  <Projects />
  <Skills />
  <Toolkit />
  <Faq />
  <Certifications />
  <Contact />
</Layout>
