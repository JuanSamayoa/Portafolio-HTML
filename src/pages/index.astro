---
import { personalInfo } from "../data/personal";
import { projectsData } from "../data/projects";
import {
  additionalCertifications,
  featuredCertifications,
} from "../data/certifications";

const allCertificationsCount =
  featuredCertifications.length + additionalCertifications.length;
const pageTitle = "Juan Samayoa | QA Automation Engineer";
const pageDescription =
  "Portafolio profesional de Juan Samayoa, QA Automation Engineer en Guatemala especializado en Playwright, Java, SQL y pruebas funcionales.";
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : "https://juan-samayoa.is-a.dev/";
const previewImage = Astro.site
  ? new URL(personalInfo.profileImage, Astro.site).toString()
  : "https://juan-samayoa.is-a.dev/assets/img/profile.jpg";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content="Juan Samayoa" />
    <meta
      name="keywords"
      content="QA Automation Engineer, Playwright, Java, Selenium, Postman, SQL, Guatemala, Testing"
    />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:alt" content="Foto de perfil de Juan Samayoa" />
    <meta property="og:site_name" content="Juan Samayoa Portfolio" />
    <meta property="og:locale" content="es_GT" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="theme-color" content="#1d9e75" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <nav>
      <a class="nav-logo" href="#hero" aria-label="Ir al inicio">
        <span class="nav-logo-dot"></span>
        Juan Samayoa
      </a>
      <ul class="nav-links">
        <li><a href="#impacto">impacto</a></li>
        <li><a href="#servicios">servicios</a></li>
        <li><a href="#casos">casos</a></li>
        <li><a href="#sobre">sobre</a></li>
        <li><a href="#experiencia">experiencia</a></li>
        <li><a href="#proyectos">proyectos</a></li>
        <li><a href="#habilidades">stack</a></li>
        <li><a href="#certificaciones">certs</a></li>
      </ul>
      <a href="#contacto" class="nav-cta">contacto -></a>
    </nav>

    <main>
      <section id="hero">
        <div class="hero-bg-grid"></div>
        <div class="hero-bg-glow"></div>
        <div class="container">
          <div class="hero-inner">
            <div class="hero-left reveal">
              <div class="hero-available">
                <span class="available-dot"></span>
                disponible para colaboracion
              </div>
              <h1 class="hero-title">
                QA Automation Engineer
                <span class="hero-title-accent">Software Quality Specialist</span>
              </h1>
              <p class="hero-subtitle">
                PLAYWRIGHT · JAVA · PYTHON · GUATEMALA CITY
              </p>
              <p class="hero-desc">
                QA Engineer especializado en automatizacion, pruebas
                funcionales y validacion de datos. Combino criterio QA con base
                de desarrollo para entregar cobertura real, trazable y util.
              </p>
              <div class="hero-tags">
                <span class="tag tag-primary">Playwright</span>
                <span class="tag tag-primary">Java</span>
                <span class="tag">Python</span>
                <span class="tag">Black-box</span>
                <span class="tag">White-box</span>
                <span class="tag">CI/CD</span>
                <span class="tag">SQL</span>
              </div>
              <div class="language-strip" aria-label="Idiomas">
                <span>Español nativo</span>
                <span>Inglés profesional</span>
              </div>
              <div class="hero-actions">
                <a href="#proyectos" class="btn-primary">ver proyectos -></a>
                <a href="#contacto" class="btn-ghost">contactame</a>
              </div>
              <div class="response-badge">
                <span class="available-dot"></span>
                Respondo en menos de 24h · GMT-6
              </div>
            </div>

            <aside class="hero-card reveal reveal-delay-1" aria-label="Resumen tecnico">
              <div class="hero-card-header">
                <img
                  class="avatar-photo"
                  src={personalInfo.profileImage}
                  alt="Foto de perfil de Juan Samayoa"
                  loading="eager"
                />
                <div>
                  <div class="hero-card-name">Juan Enrique Samayoa</div>
                  <div class="hero-card-role">QA AUTOMATION ENGINEER · GMT-6</div>
                </div>
              </div>

              <div class="terminal">
                <div class="terminal-bar">
                  <span class="t-dot red"></span>
                  <span class="t-dot yellow"></span>
                  <span class="t-dot green"></span>
                </div>
                <div class="terminal-body">
                  <div><span class="t-prompt">~</span> <span class="t-cmd">npx playwright test</span></div>
                  <div><span class="t-comment">Running 47 tests using 4 workers</span></div>
                  <div>&nbsp;</div>
                  <div><span class="t-success">✓</span> <span class="t-comment">smoke/login.spec.ts (1.2s)</span></div>
                  <div><span class="t-success">✓</span> <span class="t-comment">api/endpoints.spec.ts (2.4s)</span></div>
                  <div><span class="t-success">✓</span> <span class="t-comment">regression/catalog.spec.ts (3.1s)</span></div>
                  <div>&nbsp;</div>
                  <div><span class="t-success">47 passed</span> <span class="t-comment">(18.7s)</span> <span class="t-cursor"></span></div>
                </div>
              </div>

              <div class="metrics">
                <div class="metric">
                  <div class="metric-num">3+</div>
                  <div class="metric-label">anos QA</div>
                </div>
                <div class="metric">
                  <div class="metric-num">47+</div>
                  <div class="metric-label">tests auto</div>
                </div>
                <div class="metric">
                  <div class="metric-num">GMT-6</div>
                  <div class="metric-label">timezone</div>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <section id="impacto">
        <div class="container">
          <div class="impact-header reveal">
            <div>
              <div class="section-tag">resultados obtenidos</div>
              <h2 class="section-title no-margin">Impacto medible en QA</h2>
            </div>
            <p>
              Indicadores de eficiencia, automatizacion y cobertura aplicados
              en procesos reales de calidad de software.
            </p>
          </div>

          <div class="impact-grid">
            <article class="impact-card reveal">
              <div class="impact-value">30%</div>
              <p>Reduccion de tiempo en ejecucion de pruebas</p>
            </article>
            <article class="impact-card reveal reveal-delay-1">
              <div class="impact-value">25%</div>
              <p>Automatizacion implementada en procesos QA</p>
            </article>
            <article class="impact-card reveal reveal-delay-2">
              <div class="impact-value">100%</div>
              <p>Automatizacion de flujo critico con Postman</p>
            </article>
            <article class="impact-card reveal reveal-delay-3">
              <div class="impact-value">3+</div>
              <p>Anos en QA</p>
            </article>
          </div>
        </div>
      </section>

      <section id="servicios">
        <div class="container">
          <div class="services-header reveal">
            <div class="section-tag">servicios profesionales</div>
            <h2 class="section-title">Especialidades QA para equipos de producto</h2>
          </div>

          <div class="services-grid">
            <article class="service-card reveal">
              <span class="service-index">01</span>
              <h3>QA Manual</h3>
              <p>
                Diseno y ejecucion de casos funcionales, regresion, smoke
                testing y reporte de defectos con evidencia clara para negocio
                y desarrollo.
              </p>
            </article>
            <article class="service-card reveal reveal-delay-1">
              <span class="service-index">02</span>
              <h3>QA Automation</h3>
              <p>
                Automatizacion de flujos repetitivos y criticos con enfoque en
                mantenibilidad, cobertura util y ejecucion continua.
              </p>
            </article>
            <article class="service-card reveal reveal-delay-2">
              <span class="service-index">03</span>
              <h3>Testing APIs</h3>
              <p>
                Validacion de endpoints, contratos, respuestas, autenticacion y
                escenarios negativos usando Postman y criterios de integracion.
              </p>
            </article>
            <article class="service-card reveal reveal-delay-3">
              <span class="service-index">04</span>
              <h3>Validacion SQL</h3>
              <p>
                Revision de integridad de datos, resultados de procesos,
                consistencia entre sistemas y evidencias mediante consultas SQL.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section id="casos">
        <div class="container">
          <div class="case-header reveal">
            <div>
              <div class="section-tag">casos de exito</div>
              <h2 class="section-title no-margin">Evidencia aplicada en QA</h2>
            </div>
            <p>
              Ejemplos concretos de problemas resueltos con automatizacion,
              validacion y criterio de calidad.
            </p>
          </div>

          <!-- Edita este bloque para agregar o cambiar casos de exito. -->
          <article class="case-card reveal">
            <div class="case-label">Caso de exito #1</div>
            <div class="case-content">
              <div>
                <h3>Automatizacion de Dashboard QA</h3>
                <p>
                  Optimizacion de un proceso operativo de validacion que
                  dependia de ejecucion manual y consumo repetitivo de tiempo.
                </p>
              </div>
              <div class="case-breakdown">
                <div class="case-point">
                  <span>Problema</span>
                  <p>Proceso manual consumia varias horas.</p>
                </div>
                <div class="case-point">
                  <span>Solucion</span>
                  <p>Java + Selenium.</p>
                </div>
                <div class="case-point result">
                  <span>Resultado</span>
                  <p>30% menos tiempo operativo.</p>
                </div>
              </div>
            </div>
          </article>
        </br>
          <article class="case-card reveal">
            <div class="case-label">Caso de exito #2</div>
            <div class="case-content">
              <div>
                <h3>Pruebas de flujo backend</h3>
                <p>
                  Optimización de proceso de prueba por medio de
                  automatización de endpoints por medio de Postman Flows
                </p>
              </div>
              <div class="case-breakdown">
                <div class="case-point">
                  <span>Problema</span>
                  <p>Proceso manual requiere probar una api a la vez.</p>
                </div>
                <div class="case-point">
                  <span>Solucion</span>
                  <p>Postman + Postman Flows. Variables globales y uso de scripts pre/post-request.</p>
                </div>
                <div class="case-point result">
                  <span>Resultado</span>
                  <p>60% menos tiempo utilizado en pruebas.</p>
                </div>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section id="sobre">
        <div class="container">
          <div class="sobre-grid">
            <div class="reveal">
              <div class="section-tag">sobre mi</div>
              <h2 class="section-title compact">
                Criterio QA<br />con mentalidad<br />de developer
              </h2>
              <p class="sobre-text">
                Ingeniero de pruebas con experiencia en banca, servicios y
                automatizacion. Trabajo con pruebas funcionales, Playwright,
                Java, Postman y SQL para validar flujos criticos de negocio.
              </p>
              <p class="sobre-text">
                Mi objetivo en cada proyecto: menos reprocesos, cobertura real
                donde importa y visibilidad del estado de calidad para QA,
                desarrollo y negocio.
              </p>
              <div class="sobre-values">
                <span class="value-pill">Calidad</span>
                <span class="value-pill">Responsabilidad</span>
                <span class="value-pill">Comunicacion</span>
                <span class="value-pill">Mejora continua</span>
                <span class="value-pill">Aprendizaje rapido</span>
              </div>
              <div class="availability-box">
                <div class="avail-title">Disponibilidad actual</div>
                <div class="avail-modes">
                  <span class="avail-mode">Remoto</span>
                  <span class="avail-mode">Hibrido (Guatemala)</span>
                  <span class="avail-mode">Freelance</span>
                </div>
              </div>
            </div>

            <div class="reveal reveal-delay-2">
              <div class="section-tag">como trabajo</div>
              <h3 class="process-title">Mi proceso QA</h3>
              <div class="steps">
                <div class="step">
                  <div class="step-num">01</div>
                  <div>
                    <div class="step-title">Analizo objetivo, alcance y riesgo</div>
                    <div class="step-desc">Priorizo pruebas donde existe mas impacto funcional y tecnico.</div>
                  </div>
                </div>
                <div class="step">
                  <div class="step-num">02</div>
                  <div>
                    <div class="step-title">Diseno escenarios trazables</div>
                    <div class="step-desc">Casos revisables por QA, desarrollo y negocio.</div>
                  </div>
                </div>
                <div class="step">
                  <div class="step-num">03</div>
                  <div>
                    <div class="step-title">Ejecuto y automatizo donde conviene</div>
                    <div class="step-desc">Combino pruebas manuales con automatizacion de flujos repetitivos.</div>
                  </div>
                </div>
                <div class="step">
                  <div class="step-num">04</div>
                  <div>
                    <div class="step-title">Reporto con contexto</div>
                    <div class="step-desc">Documento evidencia, severidad e impacto para decisiones oportunas.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="experiencia">
        <div class="container">
          <div class="section-tag">experiencia</div>
          <h2 class="section-title">Trayectoria profesional</h2>
          <div class="exp-timeline">
            <article class="exp-item reveal">
              <div class="exp-date">marzo 2026 -> actualmente</div>
              <div>
                <div class="exp-company">Business Development Group, S.A. (Asignado a Banrural) · remoto · Guatemala</div>
                <div class="exp-role">QA Automatizador</div>
                <p class="exp-desc">
                  QA principalmente manual con pruebas de humo, regresion,
                  aceptacion, validacion funcional y pruebas de usuario sobre
                  Banca Virtual e iniciativas de mejora. Elaboracion de
                  scripts y guiones de prueba, registro y seguimiento de
                  incidentes en Azure DevOps, revision de logs, pruebas de APIs
                  generales, validacion visual y apoyo en Sybase para comprobar
                  datos y resultados de negocio.
                </p>
                <div class="exp-tags">
                  <span class="tag">QA Manual</span>
                  <span class="tag">Azure DevOps</span>
                  <span class="tag">Logs</span>
                  <span class="tag">SQL</span>
                  <span class="tag">APIs</span>
                  <span class="tag">Sybase</span>
                </div>
              </div>
            </article>

            <article class="exp-item reveal reveal-delay-1">
              <div class="exp-date">octubre 2024 -> marzo 2026</div>
              <div>
                <div class="exp-company">Conduent Business Services de Guatemala · remoto · USA</div>
                <div class="exp-role">IT Testing Engineer</div>
                <p class="exp-desc">
                  Elaboracion de guiones de prueba y ejecucion de QA manual
                  para clientes farmacéuticos y dashboards de Power BI.
                  Validacion de datos con SQL en Oracle, construccion de CTEs,
                  subqueries y consultas avanzadas para contrastar resultados,
                  revision de incidentes en Azure DevOps y apoyo con scripts en
                  Python para automatizar consultas de base de datos.
                  Mejoras en tiempos de entrega de QA de entre 15% y 20%.
                </p>
                <div class="exp-tags">
                  <span class="tag">Oracle SQL</span>
                  <span class="tag">Power BI</span>
                  <span class="tag">Azure DevOps</span>
                  <span class="tag">Python</span>
                  <span class="tag">Excel</span>
                  <span class="tag">QA Manual</span>
                </div>
              </div>
            </article>

            <article class="exp-item reveal reveal-delay-2">
              <div class="exp-date">julio 2022 -> octubre 2024</div>
              <div>
                <div class="exp-company">Banco Industrial, S.A. · Zona 4, Ciudad de Guatemala</div>
                <div class="exp-role">Analista QA Especializado</div>
                <p class="exp-desc">
                  QA manual para el proyecto de Agentes Bancarios, con
                  elaboracion de scripts de prueba como base para automatizacion
                  posterior. Ejecucion de pruebas funcionales y de humo,
                  primera automatizacion backend con Postman Flows y flujo E2E
                  inicial del producto. Reduccion de tiempos de QA de hasta 35%.
                </p>
                <div class="exp-tags">
                  <span class="tag">Postman</span>
                  <span class="tag">Jira</span>
                  <span class="tag">SOAP UI</span>
                  <span class="tag">PostgreSQL</span>
                  <span class="tag">AWS</span>
                  <span class="tag">AS/400</span>
                </div>
              </div>
            </article>

            <article class="exp-item reveal reveal-delay-3">
              <div class="exp-date">mayo 2022 -> julio 2022</div>
              <div>
                <div class="exp-company">Alorica Comunicaciones Limitada · remoto · USA</div>
                <div class="exp-role">Asociado de soporte de Operaciones (T-Mobile)</div>
                <p class="exp-desc">
                  Soporte al frontline de operaciones con resolucion de
                  bloqueos de telefonos, escalaciones de agentes, accesos,
                  metricas de rendimiento y apoyo general al negocio. Trabajo
                  con herramientas internas, knowledge base, Citrix, Power BI,
                  Excel y Slack.
                </p>
                <div class="exp-tags">
                  <span class="tag">Power BI</span>
                  <span class="tag">Excel</span>
                  <span class="tag">Citrix</span>
                  <span class="tag">Slack</span>
                  <span class="tag">Knowledge Base</span>
                  <span class="tag">Customer Ops</span>
                </div>
              </div>
            </article>

            <article class="exp-item reveal">
              <div class="exp-date">abril 2021 -> mayo 2022</div>
              <div>
                <div class="exp-company">Alorica Comunicaciones Limitada · remoto · USA</div>
                <div class="exp-role">Representante de servicio al cliente (T-Mobile)</div>
                <p class="exp-desc">
                  Atencion al cliente para resolucion de cuentas, pagos,
                  politicas de uso, ventas de productos y servicios, y gestion
                  de casos con enfoque en satisfaccion y resolucion en la
                  primera llamada. Uso de C2, sistemas internos, Citrix y
                  Slack para seguimiento operativo.
                </p>
                <div class="exp-tags">
                  <span class="tag">C2</span>
                  <span class="tag">Citrix</span>
                  <span class="tag">Slack</span>
                  <span class="tag">Customer Support</span>
                  <span class="tag">Sales</span>
                  <span class="tag">Operations</span>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="proyectos">
        <div class="container">
          <div class="projects-header">
            <div>
              <div class="section-tag">proyectos</div>
              <h2 class="section-title no-margin">Proyectos</h2>
            </div>
            <a href={personalInfo.github} class="btn-ghost" target="_blank" rel="noreferrer">ver GitHub -></a>
          </div>

          <div class="projects-grid">
            {
              projectsData.map((project, index) => (
                <article
                  class:list={[
                    "project-card reveal",
                    project.featured && "featured",
                    `reveal-delay-${index % 4}`,
                  ]}
                >
                  <div class="project-img media">
                    {project.image && (
                      <img src={project.image} alt={`Vista previa de ${project.title}`} loading="lazy" />
                    )}
                    <span class:list={["project-type-badge", project.featured ? "badge-pro" : "badge-personal"]}>
                      {project.featured ? "destacado" : project.github ? "github" : "profesional"}
                    </span>
                  </div>
                  <div class="project-body">
                    <div class="project-title">{project.title}</div>
                    <p class="project-desc">{project.description}</p>
                    <div class="project-stack">
                      {project.tags.map((tag) => (
                        <span class="stack-chip">{tag.text}</span>
                      ))}
                    </div>
                    <div class="project-actions">
                      {project.github ? (
                        <a href={project.github} class="project-link" target="_blank" rel="noreferrer">
                          ver codigo ->
                        </a>
                      ) : (
                        <span class="project-link muted">codigo privado</span>
                      )}
                      {project.link && (
                        <a href={project.link} class="project-link" target="_blank" rel="noreferrer">
                          ver demo ->
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="habilidades">
        <div class="container">
          <div class="stack-header reveal">
            <div>
              <div class="section-tag">mi stack profesional</div>
              <h2 class="section-title no-margin">Como construyo calidad</h2>
            </div>
            <p>
              Herramientas y entornos que uso para QA manual, validacion de
              datos, revisiones de APIs, seguimiento de incidentes y soporte
              operativo.
            </p>
          </div>
          <div class="stack-categories">
            <article class="stack-category reveal">
              <div class="stack-cat-icon">QA</div>
              <div class="stack-cat-title">QA Manual</div>
              <div class="stack-pills">
                <span>Smoke</span>
                <span>Regression</span>
                <span>UAT</span>
                <span>Functional</span>
                <span>Postman</span>
                <span>Visual</span>
              </div>
            </article>

            <article class="stack-category reveal reveal-delay-1">
              <div class="stack-cat-icon warm">DB</div>
              <div class="stack-cat-title">Datos</div>
              <div class="stack-pills">
                <span>Oracle SQL</span>
                <span>Sybase</span>
                <span>PostgreSQL</span>
                <span>Power BI</span>
                <span>Excel</span>
                <span>Python</span>
              </div>
            </article>

            <article class="stack-category reveal reveal-delay-2">
              <div class="stack-cat-icon blue">DEV</div>
              <div class="stack-cat-title">APIs e Integraciones</div>
              <div class="stack-pills">
                <span>Azure DevOps</span>
                <span>Jira</span>
                <span>SOAP UI</span>
                <span>Postman</span>
                <span>Git</span>
              </div>
            </article>

            <article class="stack-category reveal reveal-delay-3">
              <div class="stack-cat-icon dark">OPS</div>
              <div class="stack-cat-title">Soporte y Plataformas</div>
              <div class="stack-pills">
                <span>Citrix</span>
                <span>Slack</span>
                <span>C2</span>
                <span>AWS</span>
                <span>CloudWatch</span>
                <span>AS/400</span>
              </div>
            </article>
          </div>
        </div>
