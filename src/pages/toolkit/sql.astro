---
import Layout from "../../layouts/Layout.astro";
import { personalInfo } from "../../data/personal";

const title = "SQL Validation Playground | Juan Samayoa — QA Toolkit";
const description =
  "Ejemplos interactivos de consultas SQL para validación de datos: CTEs, subconsultas, window functions y más para QA.";
const canonicalUrl = "https://juan-samayoa.is-a.dev/toolkit/sql";
const previewImage =
  "https://res.cloudinary.com/df3b2ec0h/image/upload/v1785439772/humanresources_tqjseu.webp";

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "SQL Validation Playground — Toolkit QA",
  description,
  url: canonicalUrl,
  author: { "@type": "Person", name: personalInfo.name },
};

interface SqlExample {
  id: string;
  title: string;
  description: string;
  code: string;
  resultPreview: string;
}

const examples: SqlExample[] = [
  {
    id: "cte",
    title: "CTE — Common Table Expression",
    description:
      "Las CTEs permiten crear consultas temporales con nombre dentro de una sentencia SQL. Ideales para validar datos paso a paso en QA.",
    code: `-- ============================================
-- CTE: Clientes con múltiples transacciones
-- ============================================
WITH transacciones_recientes AS (
    SELECT
        c.cliente_id,
        c.nombre,
        c.email,
        COUNT(t.transaccion_id) AS total_tx,
        SUM(t.monto) AS monto_total,
        MAX(t.fecha) AS ultima_tx
    FROM clientes c
    LEFT JOIN transacciones t ON c.cliente_id = t.cliente_id
    WHERE t.fecha >= DATEADD(MONTH, -3, GETDATE())
    GROUP BY c.cliente_id, c.nombre, c.email
    HAVING COUNT(t.transaccion_id) > 5
)
SELECT
    cliente_id,
    nombre,
    email,
    total_tx,
    monto_total,
    ultima_tx
FROM transacciones_recientes
ORDER BY monto_total DESC;`,
    resultPreview: ` cliente_id | nombre         | email                  | total_tx | monto_total | ultima_tx
-----------+----------------+------------------------+----------+-------------+-----------
       142 | María López    | mlopez@email.com       |       12 |    15800.50 | 2026-07-28
        89 | Carlos Méndez  | cmendez@email.com      |        9 |    12450.00 | 2026-07-25
       231 | Ana Guatemala  | aguatemala@email.com   |        8 |     9200.75 | 2026-07-30`,
  },
  {
    id: "subquery",
    title: "Subconsulta — Validación de integridad",
    description:
      "Las subconsultas permiten validar consistencia entre tablas. Este ejemplo encuentra registros huérfanos o no referenciados.",
    code: `-- ============================================
-- Subconsulta: Pedidos sin cliente válido
-- ============================================
-- Útil para detectar datos huérfanos en ETLs
SELECT
    p.pedido_id,
    p.fecha_pedido,
    p.cliente_id,
    p.monto_total,
    CASE
        WHEN c.cliente_id IS NULL THEN 'HUÉRFANO'
        ELSE 'VÁLIDO'
    END AS estado_integridad
FROM pedidos p
LEFT JOIN clientes c ON p.cliente_id = c.cliente_id
WHERE p.cliente_id NOT IN (
    SELECT cliente_id FROM clientes WHERE activo = 1
)
ORDER BY p.fecha_pedido DESC;`,
    resultPreview: ` pedido_id | fecha_pedido | cliente_id | monto_total | estado_integridad
-----------+--------------+------------+-------------+-------------------
     45012 | 2026-07-29   |      999   |     3200.00 | HUÉRFANO
     44891 | 2026-07-22   |      999   |      890.50 | HUÉRFANO
     44723 | 2026-07-15   |      876   |     5600.00 | VÁLIDO`,
  },
  {
    id: "window",
    title: "Window Function — Ranking de calidad",
    description:
      "Las funciones de ventana permiten rankear, acumular y comparar datos sin perder detalle fila por fila. Excelente para detectar anomalías.",
    code: `-- ============================================
-- Window Function: Ranking por departamento
-- ============================================
SELECT
    d.nombre_departamento,
    e.nombre_empleado,
    e.salario,
    ROW_NUMBER() OVER (
        PARTITION BY d.departamento_id
        ORDER BY e.salario DESC
    ) AS rank_salario,
    ROUND(
        AVG(e.salario) OVER (
            PARTITION BY d.departamento_id
        ), 2
    ) AS salario_promedio_dpto,
    ROUND(
        e.salario - AVG(e.salario) OVER (
            PARTITION BY d.departamento_id
        ), 2
    ) AS diferencia_vs_promedio
FROM empleados e
JOIN departamentos d ON e.departamento_id = d.departamento_id
ORDER BY d.nombre_departamento, rank_salario;`,
    resultPreview: ` departamento  | empleado       | salario | rank | promedio | diferencia
--------------+----------------+---------+------+----------+------------
 QA           | Juan Samayoa   | 18500   |    1 | 15200.50 |   3299.50
 QA           | María García   | 16200   |    2 | 15200.50 |    999.50
 QA           | Pedro López    | 14800   |    3 | 15200.50 |   -400.50
 Desarrollo   | Ana Soto       | 22000   |    1 | 18300.00 |   3700.00`,
  },
  {
    id: "inline",
    title: "Inline Query — Validación rápida de datos",
    description:
      "Consultas inline para validaciones rápidas en consola SQL o scripts ad-hoc. Ideales para verificar datos en ambientes de QA.",
    code: `-- ============================================
-- Inline: Resumen rápido de calidad de datos
-- ============================================
SELECT
    'Total Clientes' AS metrica, COUNT(*) AS valor FROM clientes
UNION ALL
SELECT 'Clientes Activos', COUNT(*) FROM clientes WHERE activo = 1
UNION ALL
SELECT 'Clientes sin Email', COUNT(*) FROM clientes WHERE email IS NULL
UNION ALL
SELECT 'Transacciones Hoy', COUNT(*) FROM transacciones WHERE CAST(fecha AS DATE) = CAST(GETDATE() AS DATE)
UNION ALL
SELECT 'Promedio Transacciones/día', ROUND(AVG(tx_count), 0)
FROM (
    SELECT COUNT(*) AS tx_count
    FROM transacciones
    GROUP BY CAST(fecha AS DATE)
) AS diario;`,
    resultPreview: ` metrica                      | valor
------------------------------+-------
 Total Clientes               |  1542
 Clientes Activos             |  1206
 Clientes sin Email           |    23
 Transacciones Hoy            |   847
 Promedio Transacciones/día   |   912`,
  },
  {
    id: "data-validation",
    title: "Validación de Integridad Referencial",
    description:
      "Consulta que verifica integridad referencial entre tablas. Detecta registros en una tabla hija sin correspondencia en la tabla padre.",
    code: `-- ============================================
-- Validación: Integridad Referencial
-- ============================================
-- Detecta transacciones sin cliente válido
-- y calcula el porcentaje de integridad
WITH check_integridad AS (
    SELECT
        COUNT(*) AS total_transacciones,
        SUM(CASE WHEN c.cliente_id IS NULL THEN 1 ELSE 0 END) AS huerfanas,
        ROUND(
            100.0 * SUM(CASE WHEN c.cliente_id IS NULL THEN 1 ELSE 0 END)
            / NULLIF(COUNT(*), 0), 2
        ) AS porcentaje_huerfanas
    FROM transacciones t
    LEFT JOIN clientes c ON t.cliente_id = c.cliente_id
),
muestras_huerfanas AS (
    SELECT TOP 5
        t.transaccion_id,
        t.cliente_id,
        t.monto,
        t.fecha
    FROM transacciones t
    LEFT JOIN clientes c ON t.cliente_id = c.cliente_id
    WHERE c.cliente_id IS NULL
)
SELECT * FROM check_integridad;
-- SELECT * FROM muestras_huerfanas; -- Descomentar para ver muestras`,
    resultPreview: ` total_transacciones | huerfanas | porcentaje_huerfanas
--------------------+-----------+---------------------
             152840 |        47 |                0.03`,
  },
];

const allSqlCode = examples.map((ex) => ex.code).join("\n\n\n");
---

<Layout {title} {description} {canonicalUrl} {previewImage} {schemaOrg} robots="noindex, follow">
  <section class="sql-hero">
    <div class="container">
      <a href="/#toolkit" class="back-link">← volver al toolkit</a>
      <div class="sql-hero-content reveal">
        <span class="section-tag">toolkit qa</span>
        <h1 class="sql-title">SQL Validation Playground</h1>
        <p class="sql-subtitle">
          Colección de consultas SQL para validación de datos, CTEs,
          subconsultas y window functions. Ideales para QA y testing de datos.
        </p>
        <div class="sql-actions">
          <button class="btn-primary download-all-btn">
            descargar todo como .sql →
          </button>
          <span class="sql-stats">5 ejemplos · SQL Server / T-SQL</span>
        </div>
      </div>
    </div>
  </section>

  <section class="sql-examples">
    <div class="container">
      <div class="examples-list">
        {examples.map((ex, i) => (
          <article class="sql-example-card reveal" id={ex.id}>
            <div class="example-header">
              <span class="example-number">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h2 class="example-title">{ex.title}</h2>
                <p class="example-desc">{ex.description}</p>
              </div>
            </div>

            <div class="code-block-wrapper">
              <div class="code-bar">
                <span class="code-lang">SQL</span>
                <button class="copy-btn" data-copy={ex.id}>
                  copiar →
                </button>
              </div>
              <div class="code-block">
                <pre><code class="language-sql">{ex.code}</code></pre>
              </div>
            </div>

            <details class="result-preview">
              <summary>
                <span>ver resultado de ejemplo →</span>
              </summary>
              <div class="result-block">
                <div class="code-bar">
                  <span class="code-lang">resultado</span>
                </div>
                <pre><code>{ex.resultPreview}</code></pre>
              </div>
            </details>
          </article>
        ))}
      </div>

      <div class="sql-cta reveal">
        <p>
          Estas consultas son ejemplos prácticos para validación de datos en
          QA. Adáptalos a tu esquema de base de datos y necesidades de negocio.
        </p>
        <button class="btn-primary download-all-btn">
          descargar colección completa →
        </button>
      </div>
    </div>
  </section>
</Layout>

<!-- Datos pasados de Astro a JS vía JSON script -->
<script type="application/json" id="sql-all-data" is:inline>{JSON.stringify(allSqlCode)}</script>

<script>
  const sqlData = document.getElementById("sql-all-data");
  const ALL_SQL = sqlData ? JSON.parse(sqlData.textContent!) : "";

  // Copy to clipboard
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.copy;
      const parent = id ? document.getElementById(id) : null;
      const pre = parent?.querySelector<HTMLElement>(".code-block pre code");
      if (!pre) return;
      const text = pre.textContent || "";
      navigator.clipboard.writeText(text).then(() => {
        const orig = btn.textContent;
        btn.textContent = "✓ copiado";
        btn.classList.add("copied");
        setTimeout(() => {
          btn.textContent = orig;
          btn.classList.remove("copied");
        }, 2000);
      });
    });
  });

  // Download all as .sql file
  function downloadSql() {
    const header = `-- SQL Validation Queries para QA
-- Autor: Juan Samayoa
-- Fecha: ${new Date().toISOString().split("T")[0]}
-- Base de datos: SQL Server / T-SQL
-- ============================================
`;
    const footer = `\n-- ============================================
-- Fin del script`;
    const code = header + ALL_SQL + footer;
    const blob = new Blob([code], { type: "text/sql;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "sql-validation-queries.sql";
    a.click();
    URL.revokeObjectURL(url);
  }

  document.querySelectorAll(".download-all-btn").forEach((btn) => {
    btn.addEventListener("click", downloadSql);
  });
</script>

<style>
  .sql-hero {
    padding: 140px 0 80px;
    background: linear-gradient(135deg, var(--gray-900), var(--teal-800));
    color: white;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--teal-200);
    font-family: var(--mono);
    font-size: 12px;
    text-decoration: none;
    margin-bottom: 32px;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: white;
  }

  .sql-title {
    font-family: var(--display);
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 700;
    line-height: 0.95;
    margin: 16px 0 20px;
  }

  .sql-subtitle {
    max-width: 620px;
    color: var(--gray-400);
    font-size: 17px;
    line-height: 1.6;
  }

  .sql-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 32px;
  }

  .sql-stats {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--gray-400);
    letter-spacing: 0.04em;
  }

  .sql-examples {
    background: var(--gray-50);
    padding: 80px 0;
  }

  .examples-list {
    display: grid;
    gap: 48px;
  }

  .sql-example-card {
    border: 1px solid var(--gray-200);
    border-radius: 16px;
    background: white;
    overflow: hidden;
  }

  .example-header {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: 28px 28px 0;
  }

  .example-number {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--teal-50);
    color: var(--teal-600);
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 500;
  }

  .example-title {
    font-family: var(--display);
    font-size: 22px;
    font-weight: 700;
    color: var(--gray-900);
    margin-bottom: 8px;
  }

  .example-desc {
    color: var(--gray-600);
    font-size: 14px;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .code-block-wrapper {
    margin: 0 28px 20px;
    border: 1px solid var(--gray-200);
    border-radius: 10px;
    overflow: hidden;
  }

  .code-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: #1a1a18;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .code-lang {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--teal-200);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .copy-btn {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--gray-400);
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 4px;
    padding: 4px 10px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .copy-btn:hover,
  .copy-btn:focus-visible {
    color: white;
    border-color: var(--teal-200);
    background: rgba(93, 202, 165, 0.1);
  }

  .copy-btn:focus-visible,
  .back-link:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  .result-preview summary:focus-visible {
    outline: var(--focus-ring);
    outline-offset: -2px;
    border-radius: 8px;
  }

  .copy-btn.copied {
    color: var(--teal-200);
    border-color: var(--teal-200);
    background: rgba(93, 202, 165, 0.15);
  }

  .code-block,
  .result-block {
    overflow-x: auto;
  }

  .code-block pre,
  .result-block pre {
    padding: 20px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.7;
    tab-size: 4;
  }

  .code-block pre {
    background: #1a1a18;
    color: #d6d4cb;
  }

  .code-block code {
    color: #d6d4cb;
  }

  /* SQL syntax colors within the code */
  .code-block code {
    --sql-keyword: #5dcaa5;
    --sql-function: #7ec8e3;
    --sql-string: #d4b87a;
    --sql-comment: #8a8880;
    --sql-number: #c9a0dc;
    --sql-operator: #e6db74;
  }

  .result-block pre {
    background: var(--gray-100);
    color: var(--gray-600);
    font-size: 12px;
  }

  .result-preview {
    margin: 0 28px 28px;
    border: 1px solid var(--gray-200);
    border-radius: 10px;
    overflow: hidden;
  }

  .result-preview summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    cursor: pointer;
    list-style: none;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--teal-600);
    transition: background 0.2s ease;
  }

  .result-preview summary::-webkit-details-marker {
    display: none;
  }

  .result-preview summary:hover {
    background: var(--teal-50);
  }

  .result-preview summary::before {
    content: "▶";
    font-size: 10px;
    transition: transform 0.2s ease;
  }

  .result-preview[open] summary::before {
    transform: rotate(90deg);
  }

  .sql-cta {
    margin-top: 64px;
    padding: 36px;
    border: 1px solid var(--gray-200);
    border-radius: 16px;
    background: white;
    text-align: center;
  }

  .sql-cta p {
    max-width: 560px;
    margin: 0 auto 24px;
    color: var(--gray-600);
    font-size: 15px;
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .example-header {
      flex-direction: column;
      padding: 20px 20px 0;
    }

    .code-block-wrapper {
      margin: 0 16px 16px;
    }

    .code-block pre,
    .result-block pre {
      padding: 14px;
      font-size: 12px;
    }

    .result-preview {
      margin: 0 16px 20px;
    }

    .sql-cta {
      padding: 24px 20px;
    }
  }
</style>
